{
  "name": "memory-garden",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "pnpm --filter @memory-garden/web dev",
    "build": "pnpm -r build",
    "check": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @memory-garden/web test:e2e",
    "flowers:assets": "node scripts/download-curtis-flower-assets.mjs",
    "locations:generate": "node scripts/generate-turkey-locations.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "typescript": "7.0.2",
    "sharp": "^0.34.0"
  }
}

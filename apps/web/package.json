{
  "name": "@memory-garden/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n app,api -c blue,green \"pnpm dev:app\" \"pnpm dev:api\"",
    "dev:app": "react-router dev",
    "dev:api": "wrangler dev --port 8787",
    "build": "react-router build",
    "preview": "wrangler dev --port 4173",
    "typegen": "react-router typegen && wrangler types",
    "typecheck": "pnpm typegen && tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@memory-garden/shared": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "hono": "^4.13.13",
    "isbot": "^5",
    "lucide-react": "^1.64.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.0",
    "wrangler": "^4.149.0"
  }
}
